# Cấu hình cổng cho Backend ExpressTS
PORT=4000

# Chuỗi kết nối PostgreSQL cho Prisma
# Hãy thay đổi user, password, host, port và tên database phù hợp với máy của bạn
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pomodoro_db?schema=public"

# Khóa bí mật để ký JWT cho người dùng đăng nhập lưu tiến trình
JWT_SECRET="pomofocus-super-secret-jwt-key-2026"

# Google OAuth2 Client ID (Lấy từ Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=""

# Origin của Frontend ReactTS
CLIENT_URL="http://localhost:5173"
